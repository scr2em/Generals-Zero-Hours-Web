# Settings of the Zero Hour web network server, read by run-server.sh and by the systemd unit.
# Copy to /etc/zhnet/zhnet.env (or ./zhnet.env) and edit. Every line is optional; see `run-server.sh --help`.

# Where to listen. Behind a reverse proxy on the same machine keep 127.0.0.1.
HOST=127.0.0.1
PORT=8787

# Serve the game build too (one process does everything; put a TLS proxy in front of it). Leave out if the
# game is hosted elsewhere (then set ZHNET_ORIGINS to that site and point the page at wss://this-host/signal).
#ZHNET_STATIC=/srv/zh/site

# Only pages from these sites may open the WebSocket (comma separated).
ZHNET_ORIGINS=https://play.example.com

# Behind nginx/Caddy: take the client address (for the per-address limits) from X-Forwarded-For.
ZHNET_TRUST_PROXY=1

# NAT traversal. STUN is a free public one by default; TURN is for players behind symmetric NATs.
#ZHNET_STUN=stun:stun.l.google.com:19302
#ZHNET_TURN=turn:turn.example.com:3478,turns:turn.example.com:5349
#ZHNET_TURN_SECRET=change-me-same-as-static-auth-secret-in-turnserver.conf
#ZHNET_TURN_TTL=86400

# Limits (the defaults are fine for a few hundred players)
#ZHNET_MAX_ROOMS=500
#ZHNET_MAX_PLAYERS=16
#ZHNET_MAX_PER_IP=24
